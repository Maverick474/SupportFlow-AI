# MongoDB runs as a Docker service. Use "mongodb" as the host in Compose.
MONGODB_URI=mongodb://mongodb:27017/supportflow
MONGODB_DATABASE=supportflow

# Redis runs as a Docker service. Redis 8 includes the modules used by LangGraph.
REDIS_URL=redis://redis:6379/0

# Supabase remains a hosted service and stores agents, runs, knowledge, and vectors.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=replace_with_server_secret_key

# API access and application authentication.
OPENROUTER_API_KEY=replace_with_openrouter_api_key
JWT_SECRET_KEY=replace_with_a_long_random_secret

# LangSmith traces every workflow and agent node.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace_with_langsmith_api_key
LANGSMITH_PROJECT=supportflow-ai-development

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
